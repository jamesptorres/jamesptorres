---
// Photo-led welcome. Uses src/assets/welcome.(jpg|png|webp) if present,
// otherwise the headshot, otherwise a warm gradient.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { AUTHOR, LINKEDIN_URL, WELCOME_PHOTO_ALT } from '../consts';
import Avatar from './Avatar.astro';

const pick = (g: Record<string, { default: ImageMetadata }>) => Object.values(g)[0]?.default;
const welcome = pick(import.meta.glob<{ default: ImageMetadata }>('../assets/welcome.{jpg,jpeg,png,webp}', { eager: true }));
const headshot = pick(import.meta.glob<{ default: ImageMetadata }>('../assets/headshot.{jpg,jpeg,png,webp}', { eager: true }));
const photo = welcome ?? headshot;
---
<section class="welcome-hero">
  <div class="welcome-photo">
    {photo
      ? <Image src={photo} alt={welcome ? WELCOME_PHOTO_ALT : AUTHOR} widths={[700, 1100, 1600]} sizes="(max-width: 760px) 100vw, 680px" loading="eager" />
      : <div class="welcome-photo-fallback" aria-hidden="true"></div>}
  </div>
  <div class="welcome-card">
    <div class="welcome-greeting">
      <Avatar size={144} eager />
      <h1>Hi, I'm James.</h1>
    </div>
    <p>I'm a technical architect in the Microsoft business applications world. My roots are in Dynamics 365 Finance &amp; Operations, and my work increasingly spans Power Platform, Azure, and AI.</p>
    <p>Here I share practical notes from real projects, plus where AI, agents, and headless architectures are taking business applications.</p>
    <div class="welcome-actions">
      <a class="btn" href="/blog/">Read the blog</a>
      <a href="/about/">More about me</a>
      <a href={LINKEDIN_URL} rel="me noopener">LinkedIn</a>
    </div>
  </div>
</section>

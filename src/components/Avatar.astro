---
// Shows src/assets/headshot.(jpg|jpeg|png|webp) if present, otherwise initials.
// Display size is set by CSS from the surrounding context; `size` is the largest render size.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { AUTHOR } from '../consts';

interface Props { size?: number; eager?: boolean }
const { size = 220, eager = false } = Astro.props;
const found = import.meta.glob<{ default: ImageMetadata }>('../assets/headshot.{jpg,jpeg,png,webp}', { eager: true });
const img = Object.values(found)[0]?.default;
---
{img ? (
  <Image src={img} alt={AUTHOR} width={size} height={size} densities={[1, 2]} class="avatar"
    loading={eager ? 'eager' : 'lazy'} />
) : (
  <div class="avatar avatar-fallback" role="img" aria-label={AUTHOR}>JT</div>
)}

---
import { SITE_TITLE, SITE_TAGLINE, AUTHOR, LINKEDIN_URL, GITHUB_URL, DISCLAIMER } from '../consts';
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <strong>{SITE_TITLE}</strong>
        <p>{SITE_TAGLINE}</p>
      </div>
      <nav class="footer-links" aria-label="Footer">
        <a href="/blog/">Blog</a>
        <a href="/contributions/">Contributions</a>
        <a href="/about/">About</a>
        <a href={LINKEDIN_URL} rel="me noopener">LinkedIn</a>
        <a href={GITHUB_URL} rel="me noopener">GitHub</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </div>
    <div class="footer-legal">
      <span>© {new Date().getFullYear()} {AUTHOR}</span>
      <span class="disclaimer">{DISCLAIMER}</span>
    </div>
  </div>
</footer>

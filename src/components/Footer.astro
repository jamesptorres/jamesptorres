---
import { AUTHOR, SITE_TAGLINE, LINKEDIN_URL, GITHUB_URL, DISCLAIMER } from '../consts';
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-row">
      <div>
        <strong>{AUTHOR}</strong>
        <p>{SITE_TAGLINE}</p>
      </div>
      <nav class="footer-links" aria-label="Footer">
        <a href="/blog/">Blog</a>
        <a href="/contributions/">Contributions</a>
        <a href="/about/">About</a>
        <a href={LINKEDIN_URL} rel="me noopener">LinkedIn</a>
        <a href={GITHUB_URL} rel="me noopener">GitHub</a>
      </nav>
    </div>
    <p class="footer-small">© {new Date().getFullYear()} {AUTHOR}. {DISCLAIMER}</p>
  </div>
</footer>

---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../utils';
interface Props { posts: CollectionEntry<'blog'>[] }
const { posts } = Astro.props;
---
{posts.length === 0 ? (
  <p class="empty">Nothing here yet. The first posts are coming soon.</p>
) : (
  <ul class="post-list">
    {posts.map((p) => (
      <li>
        <time class="post-date" datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate)}</time>
        {p.data.draft && <span class="draft-banner" style="margin:0 0 0 8px">Draft</span>}
        <h3><a href={`/blog/${p.id}/`}>{p.data.title}</a></h3>
        <p>{p.data.description}</p>
      </li>
    ))}
  </ul>
)}

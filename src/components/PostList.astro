---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../utils';
interface Props { posts: CollectionEntry<'blog'>[] }
const { posts } = Astro.props;
---
{posts.length === 0 ? <p>No posts yet. Soon.</p> : (
  <ul class="post-list">
    {posts.map((p) => (
      <li>
        <time datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate)}</time>
        <a href={`/blog/${p.id}/`}>{p.data.title}</a>{p.data.draft && <span class="draft-tag">draft</span>}
      </li>
    ))}
  </ul>
)}

---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, slugifyTag } from '../../utils';
const posts = await getPosts();
const byYear = Map.groupBy(posts, (p) => p.data.pubDate.getUTCFullYear());
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---
<Base title="Blog" description="All posts on Dynamics 365 F&O, AI in ERP, and headless ERP.">
  <div class="container">
    <header class="page-head">
      <h1>Blog</h1>
      <p>Notes on Dynamics 365 F&amp;O, AI in ERP, and headless architectures. <a href="/rss.xml">RSS feed</a>.</p>
    </header>
    {tags.length > 0 && (
      <ul class="chips" aria-label="Tags">
        {tags.map((t) => <li><a class="chip" href={`/tags/${slugifyTag(t)}/`}>{t}</a></li>)}
      </ul>
    )}
    {posts.length === 0 && <div style="margin-top:32px"><PostList posts={[]} /></div>}
    {[...byYear].map(([year, list]) => (
      <section class="year-group">
        <h2>{year}</h2>
        <PostList posts={list} />
      </section>
    ))}
  </div>
</Base>

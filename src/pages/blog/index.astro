---
import Base from '../../layouts/Base.astro';
import PostGrid from '../../components/PostGrid.astro';
import { getPosts, slugifyTag } from '../../utils';
const posts = await getPosts();
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---
<Base title="Blog" description="Posts on Dynamics 365 F&O, AI in ERP, and headless ERP.">
  <div class="container">
    <header class="page-head">
      <h1>Blog</h1>
      <p>Notes on Dynamics 365 F&amp;O, AI in ERP, and where it's all heading.</p>
    </header>
    {tags.length > 0 && (
      <ul class="topic-links" aria-label="Topics">
        {tags.map((t) => <li><a href={`/tags/${slugifyTag(t)}/`}>{t}</a></li>)}
      </ul>
    )}
    <PostGrid posts={posts} />
  </div>
</Base>

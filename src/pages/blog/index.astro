---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../utils';
const posts = await getPosts();
const byYear = Map.groupBy(posts, (p) => p.data.pubDate.getUTCFullYear());
---
<Base title="Blog" description="All posts, newest first.">
  <h1>Blog</h1>
  <p><a href="/tags/">Browse by tag</a> · <a href="/rss.xml">RSS</a></p>
  {posts.length === 0 && <PostList posts={[]} />}
  {[...byYear].map(([year, list]) => (
    <section>
      <h2>{year}</h2>
      <PostList posts={list} />
    </section>
  ))}
</Base>

---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../utils';
const posts = await getPosts();
const byYear = Map.groupBy(posts, (p) => p.data.pubDate.getUTCFullYear());
---
<Base title="Writing" description="Everything I've written, newest first.">
  <div class="wrap">
    <h1 class="page-title">Writing</h1>
    <p class="page-intro">Everything so far, newest first. You can also browse by <a href="/tags/">topic</a> or follow along with <a href="/rss.xml">RSS</a>.</p>
    {posts.length === 0 && <PostList posts={[]} />}
    {[...byYear].map(([year, list]) => (
      <section>
        <h2 class="year">{year}</h2>
        <PostList posts={list} />
      </section>
    ))}
  </div>
</Base>

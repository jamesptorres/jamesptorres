---
import Base from '../layouts/Base.astro';
import Avatar from '../components/Avatar.astro';
import WelcomeHero from '../components/WelcomeHero.astro';
import PostCard from '../components/PostCard.astro';
import PostGrid from '../components/PostGrid.astro';
import { getPosts } from '../utils';
const posts = await getPosts();
const [latest, ...rest] = posts;
const recent = rest.slice(0, 6);
---
<Base>
  <div class="container">
    <WelcomeHero />

    <section class="section">
      <div class="section-head">
        <h2>Latest from the blog</h2>
        {posts.length > 1 && <a href="/blog/">All posts →</a>}
      </div>
      {latest ? <PostCard post={latest} featured /> : <PostGrid posts={[]} />}
      {recent.length > 0 && <PostGrid posts={recent} />}
    </section>

    <section class="about-strip">
      <Avatar size={144} />
      <div>
        <h2>About this blog</h2>
        <p>Written by me, for anyone building on or thinking about ERP. Questions, corrections, and different opinions are always welcome.</p>
        <div class="links">
          <a href="/contributions/">Talks &amp; community work</a>
        </div>
      </div>
    </section>
  </div>
</Base>

---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../utils';
import { SITE_TAGLINE, AUTHOR } from '../consts';
const posts = (await getPosts()).slice(0, 5);
---
<Base>
  <section class="hero">
    <p class="tagline">{SITE_TAGLINE}</p>
    <p>Hi, I'm {AUTHOR}. I write about Dynamics 365 Finance &amp; Operations, AI in ERP, and where headless ERP is going. <a href="/about/">More about me →</a></p>
  </section>
  <h2>Recent posts</h2>
  <PostList posts={posts} />
  <p><a href="/blog/">All posts →</a></p>
</Base>

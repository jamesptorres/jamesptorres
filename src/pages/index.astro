---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import Avatar from '../components/Avatar.astro';
import { getPosts } from '../utils';
import { LINKEDIN_URL } from '../consts';
const posts = (await getPosts()).slice(0, 10);
---
<Base>
  <div class="wrap">
    <section class="intro">
      <Avatar size={88} eager />
      <div>
        <p>Hi, I'm James. I work with Microsoft Dynamics 365 Finance &amp; Operations, and this is where I write things down.</p>
        <p>Mostly practical notes from real projects, plus some thinking out loud about where ERP is going: AI, agents, and the move toward headless systems.</p>
        <p class="sans" style="font-size:15px;color:var(--fg-subtle)"><a href="/about/">More about me</a> · <a href={LINKEDIN_URL} rel="me noopener">LinkedIn</a> · <a href="/rss.xml">RSS</a></p>
      </div>
    </section>

    <h2 class="section-title">Recent writing</h2>
    <PostList posts={posts} />
    {posts.length >= 10 && <p class="sans" style="font-size:15px"><a href="/blog/">All posts</a></p>}
  </div>
</Base>

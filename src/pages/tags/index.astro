---
import Base from '../../layouts/Base.astro';
import { getPosts, slugifyTag } from '../../utils';
const posts = await getPosts();
const counts = new Map<string, number>();
posts.flatMap((p) => p.data.tags).forEach((t) => counts.set(t, (counts.get(t) ?? 0) + 1));
const tags = [...counts].sort((a, b) => a[0].localeCompare(b[0]));
---
<Base title="Topics" description="Posts by topic.">
  <div class="container">
    <header class="page-head"><h1>Topics</h1><p>Browse posts by subject.</p></header>
    {tags.length === 0 ? <div class="empty">No topics yet.</div> : (
      <ul class="topic-links">{tags.map(([t, n]) => <li><a href={`/tags/${slugifyTag(t)}/`}>{t} ({n})</a></li>)}</ul>
    )}
  </div>
</Base>

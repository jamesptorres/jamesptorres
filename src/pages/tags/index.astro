---
import Base from '../../layouts/Base.astro';
import { getPosts, slugifyTag } from '../../utils';
const posts = await getPosts();
const counts = new Map<string, number>();
posts.flatMap((p) => p.data.tags).forEach((t) => counts.set(t, (counts.get(t) ?? 0) + 1));
const tags = [...counts].sort((a, b) => a[0].localeCompare(b[0]));
---
<Base title="Topics" description="Posts by topic.">
  <div class="wrap">
    <h1 class="page-title">Topics</h1>
    {tags.length === 0 ? <p class="empty">No topics yet.</p> : (
      <p class="tag-cloud">{tags.map(([t, n]) => <a href={`/tags/${slugifyTag(t)}/`}>{t} ({n})</a>)}</p>
    )}
  </div>
</Base>

---
import Base from '../../layouts/Base.astro';
import { getPosts, slugifyTag } from '../../utils';
const posts = await getPosts();
const counts = new Map<string, number>();
posts.flatMap((p) => p.data.tags).forEach((t) => counts.set(t, (counts.get(t) ?? 0) + 1));
const tags = [...counts].sort((a, b) => a[0].localeCompare(b[0]));
---
<Base title="Tags" description="Posts by topic.">
  <h1>Tags</h1>
  {tags.length === 0 ? <p>No tags yet.</p> : (
    <ul class="tags">{tags.map(([t, n]) => <li><a href={`/tags/${slugifyTag(t)}/`}>#{t}</a> ({n})</li>)}</ul>
  )}
</Base>

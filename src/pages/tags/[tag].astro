---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, slugifyTag } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = new Map<string, string>();
  posts.flatMap((p) => p.data.tags).forEach((t) => tags.set(slugifyTag(t), t));
  return [...tags].map(([slug, label]) => ({
    params: { tag: slug },
    props: { label, posts: posts.filter((p) => p.data.tags.some((t) => slugifyTag(t) === slug)) },
  }));
}
const { label, posts } = Astro.props;
---
<Base title={`Posts about ${label}`} description={`Posts tagged ${label}.`}>
  <div class="wrap">
    <h1 class="page-title">Posts about {label}</h1>
    <p class="page-intro sans" style="font-size:15px"><a href="/tags/">All topics</a></p>
    <PostList posts={posts} />
  </div>
</Base>

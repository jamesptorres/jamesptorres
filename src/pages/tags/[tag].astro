---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, slugifyTag } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = new Map<string, string>();
  posts.flatMap((p) => p.data.tags).forEach((t) => tags.set(slugifyTag(t), t));
  // Always generate the home-page topic tags so those links never 404.
  for (const t of ['d365-fo', 'ai', 'headless-erp']) if (!tags.has(t)) tags.set(t, t);
  return [...tags].map(([slug, label]) => ({
    params: { tag: slug },
    props: { label, posts: posts.filter((p) => p.data.tags.some((t) => slugifyTag(t) === slug)) },
  }));
}
const { label, posts } = Astro.props;
---
<Base title={label} description={`Posts tagged ${label}.`}>
  <div class="container">
    <header class="page-head">
      <p class="eyebrow">Tag</p>
      <h1>{label}</h1>
      <p><a href="/tags/">All tags</a> · <a href="/blog/">All posts</a></p>
    </header>
    <PostList posts={posts} showTags={false} />
  </div>
</Base>

---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import Avatar from '../components/Avatar.astro';
import PostGrid from '../components/PostGrid.astro';
import { formatDate, readingTime, slugifyTag } from '../utils';
import { AUTHOR, AUTHOR_BIO, LINKEDIN_URL } from '../consts';

interface Props { post: CollectionEntry<'blog'>; more: CollectionEntry<'blog'>[] }
const { post, more } = Astro.props;
const { title, description, pubDate, updatedDate, tags, heroImage, heroAlt, draft } = post.data;
---
<Base title={title} description={description} image={heroImage?.src} type="article">
  <article>
    <header class="container-read article-head">
      {draft && <p><span class="draft-banner">Draft: not visible on the live site</span></p>}
      {tags[0] && <a class="tag" href={`/tags/${slugifyTag(tags[0])}/`}>{tags[0]}</a>}
      <h1>{title}</h1>
      <p class="dek">{description}</p>
      <div class="byline">
        <Avatar size={80} eager />
        <div>
          <strong>{AUTHOR}</strong>
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          {updatedDate && <> · Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></>}
          {' · '}{readingTime(post.body)}
        </div>
      </div>
    </header>

    {heroImage && (
      <div class="article-cover">
        <Image src={heroImage} alt={heroAlt ?? ''} widths={[860, 1720]} sizes="(max-width: 900px) 100vw, 860px" loading="eager" />
      </div>
    )}

    <div class="container-read">
      <div class="prose">
        <slot />
      </div>

      {tags.length > 1 && (
        <ul class="topic-links" style="margin-top:40px">
          {tags.map((t) => <li><a href={`/tags/${slugifyTag(t)}/`}>{t}</a></li>)}
        </ul>
      )}

      <aside class="author-box">
        <Avatar size={128} />
        <div>
          <strong>Written by {AUTHOR}</strong>
          <p>{AUTHOR_BIO} If this was useful, or you see it differently, <a href={LINKEDIN_URL} rel="me noopener">let me know on LinkedIn</a>.</p>
        </div>
      </aside>
    </div>
  </article>

  {more.length > 0 && (
    <section class="container more-posts">
      <h2>More from the blog</h2>
      <PostGrid posts={more} />
    </section>
  )}

  <script>
    document.querySelectorAll('.prose pre').forEach((pre) => {
      const btn = document.createElement('button');
      btn.className = 'copy-btn';
      btn.type = 'button';
      btn.textContent = 'Copy';
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? '');
          btn.textContent = 'Copied';
          setTimeout(() => (btn.textContent = 'Copy'), 1500);
        } catch {}
      });
      pre.appendChild(btn);
    });
  </script>
</Base>

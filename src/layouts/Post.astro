---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import Avatar from '../components/Avatar.astro';
import { formatDate, readingTime, slugifyTag } from '../utils';
import { AUTHOR, AUTHOR_BIO, LINKEDIN_URL, GITHUB_URL } from '../consts';

interface Props {
  post: CollectionEntry<'blog'>;
  prev?: CollectionEntry<'blog'>;
  next?: CollectionEntry<'blog'>;
}
const { post, prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, tags, heroImage, heroAlt, draft } = post.data;
---
<Base title={title} description={description} image={heroImage?.src} type="article">
  <article class="container-prose">
    <header class="article-head">
      {draft && <span class="draft-banner">Draft: not visible in production</span>}
      {tags.length > 0 && (
        <ul class="chips" style="margin-top:12px">
          {tags.map((t) => <li><a class="chip chip-accent" href={`/tags/${slugifyTag(t)}/`}>{t}</a></li>)}
        </ul>
      )}
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <div class="byline">
        <Avatar size={36} eager />
        <div>
          <strong>{AUTHOR}</strong>
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          {updatedDate && <> · Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></>}
          {' · '}{readingTime(post.body)}
        </div>
      </div>
    </header>

    {heroImage && (
      <div class="hero-image">
        <Image src={heroImage} alt={heroAlt ?? ''} widths={[700, 1400]} sizes="(max-width: 740px) 100vw, 700px" loading="eager" />
      </div>
    )}

    <div class="prose">
      <slot />
    </div>

    <aside class="author-card">
      <Avatar size={64} />
      <div>
        <h3>{AUTHOR}</h3>
        <p>{AUTHOR_BIO}</p>
        <div class="links">
          <a href={LINKEDIN_URL} rel="me noopener">LinkedIn</a>
          <a href={GITHUB_URL} rel="me noopener">GitHub</a>
          <a href="/about/">About</a>
        </div>
      </div>
    </aside>

    {(prev || next) && (
      <nav class="post-nav" aria-label="More posts">
        {prev && <a href={`/blog/${prev.id}/`}><small>← Older</small>{prev.data.title}</a>}
        {next && <a class="next" href={`/blog/${next.id}/`}><small>Newer →</small>{next.data.title}</a>}
      </nav>
    )}
  </article>

  <script>
    // Copy buttons on code blocks
    document.querySelectorAll('.prose pre').forEach((pre) => {
      const btn = document.createElement('button');
      btn.className = 'copy-btn';
      btn.type = 'button';
      btn.textContent = 'Copy';
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? '');
          btn.textContent = 'Copied';
          setTimeout(() => (btn.textContent = 'Copy'), 1500);
        } catch {}
      });
      pre.appendChild(btn);
    });
  </script>
</Base>

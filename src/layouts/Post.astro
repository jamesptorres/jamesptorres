---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import Avatar from '../components/Avatar.astro';
import { formatDate, readingTime, slugifyTag } from '../utils';
import { LINKEDIN_URL } from '../consts';

interface Props {
  post: CollectionEntry<'blog'>;
  prev?: CollectionEntry<'blog'>;
  next?: CollectionEntry<'blog'>;
}
const { post, prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, tags, heroImage, heroAlt, draft } = post.data;
---
<Base title={title} description={description} image={heroImage?.src} type="article">
  <article class="wrap">
    {draft && <span class="draft-banner">Draft: not visible on the live site</span>}
    <h1 class="article-title">{title}</h1>
    <p class="meta">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      {updatedDate && <> (updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>)</>}
      {' · '}{readingTime(post.body)}
      {tags.length > 0 && <> · {tags.map((t, i) => <>{i > 0 && ', '}<a href={`/tags/${slugifyTag(t)}/`}>{t}</a></>)}</>}
    </p>

    {heroImage && (
      <figure style="margin:0 0 32px">
        <Image src={heroImage} alt={heroAlt ?? ''} widths={[680, 1360]} sizes="(max-width: 720px) 100vw, 680px" loading="eager" />
      </figure>
    )}

    <div class="prose">
      <slot />
    </div>

    <div class="signoff">
      <Avatar size={52} />
      <p>Thanks for reading. If this was useful, or you see it differently, I'd like to hear from you on <a href={LINKEDIN_URL} rel="me noopener">LinkedIn</a>.</p>
    </div>

    {(prev || next) && (
      <nav class="post-nav" aria-label="More posts">
        {prev && <a href={`/blog/${prev.id}/`}>← {prev.data.title}</a>}
        {next && <a class="next" href={`/blog/${next.id}/`}>{next.data.title} →</a>}
      </nav>
    )}
  </article>

  <script>
    document.querySelectorAll('.prose pre').forEach((pre) => {
      const btn = document.createElement('button');
      btn.className = 'copy-btn';
      btn.type = 'button';
      btn.textContent = 'Copy';
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? '');
          btn.textContent = 'Copied';
          setTimeout(() => (btn.textContent = 'Copy'), 1500);
        } catch {}
      });
      pre.appendChild(btn);
    });
  </script>
</Base>

---
// Layout for Markdown pages (About, Contributions).
// Frontmatter: title, description, intro (optional), photo: true (optional)
import Base from './Base.astro';
import Avatar from '../components/Avatar.astro';
const { frontmatter } = Astro.props;
---
<Base title={frontmatter.title} description={frontmatter.description}>
  <div class="container-read">
    {frontmatter.photo ? (
      <header class="about-head">
        <Avatar size={280} eager />
        <div>
          <h1>{frontmatter.title}</h1>
          {frontmatter.intro && <p>{frontmatter.intro}</p>}
        </div>
      </header>
    ) : (
      <header class="page-head">
        <h1>{frontmatter.title}</h1>
        {frontmatter.intro && <p>{frontmatter.intro}</p>}
      </header>
    )}
    <div class="prose">
      <slot />
    </div>
  </div>
</Base>

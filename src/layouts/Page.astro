---
// Layout for Markdown pages (About, Contributions).
// Frontmatter: title, description, intro (optional), photo: true (optional)
import Base from './Base.astro';
import Avatar from '../components/Avatar.astro';
const { frontmatter } = Astro.props;
---
<Base title={frontmatter.title} description={frontmatter.description}>
  <div class="wrap">
    {frontmatter.photo && <div class="about-photo"><Avatar size={120} eager /></div>}
    <h1 class="page-title" style={frontmatter.photo ? 'margin-top:24px' : undefined}>{frontmatter.title}</h1>
    {frontmatter.intro && <p class="page-intro">{frontmatter.intro}</p>}
    <div class="prose">
      <slot />
    </div>
  </div>
</Base>
